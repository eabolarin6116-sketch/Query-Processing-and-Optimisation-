
WITH debit AS (
    UPDATE accounts
    SET balance = balance - 5000.00
    WHERE account_number = 'FIN100001'
      AND balance >= 5000.00
    RETURNING account_id, balance
)
INSERT INTO transactions (
    account_id,
    transaction_type,
    amount,
    status
)
SELECT
    account_id,
    'withdrawal',
    5000.00,
    'successful'
FROM debit
RETURNING transaction_id, account_id, transaction_type, amount, status;
