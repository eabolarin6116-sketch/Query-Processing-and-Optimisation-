
SELECT
    c.first_name,
    a.account_number,
    a.balance,
    t.transaction_type,
    t.amount,
    t.status
FROM customers AS c
JOIN accounts AS a
    ON a.customer_id = c.customer_id
JOIN transactions AS t
    ON t.account_id = a.account_id
WHERE c.email = 'ada.okafor@example.com'
ORDER BY t.transaction_id DESC
LIMIT 5;
