SELECT
    a.account_number,
    a.balance,
    t.transaction_id,
    t.transaction_type,
    t.amount,
    t.status
FROM accounts AS a
JOIN customers AS c ON c.customer_id = a.customer_id
JOIN transactions AS t ON t.account_id = a.account_id
WHERE c.email = 'ada.okafor@example.com'
ORDER BY t.transaction_id DESC
LIMIT 5;
